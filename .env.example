# SecureShip Configuration
SECURESHIP_HOST=127.0.0.1
SECURESHIP_PORT=5000
SECURESHIP_DEBUG=false
SECURESHIP_SECRET_KEY=change-to-a-secure-random-key-in-production

# Storage paths
SECURESHIP_DB_PATH=data/secureship.db

# Timeouts (seconds)
SECURESHIP_TRIVY_TIMEOUT=120
SECURESHIP_BUILD_TIMEOUT=240
SECURESHIP_RUN_TIMEOUT=30

# Deployment port range (127.0.0.1 only)
SECURESHIP_PORT_MIN=5010
SECURESHIP_PORT_MAX=5050

# Optional custom tool paths (leave blank for automatic discovery)
TRIVY_PATH=
DOCKER_PATH=
